// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    }
  },
  {
    "bindings": {
      "alt-/": ["terminal::SendText", "./build.sh\n"]
    }
  },
  {
    "bindings": {
      "alt-l": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-pagedown": "pane::ActivateNextItem"
    }
  },
  {
    "bindings": {
      "alt-k": "pane::ActivatePreviousItem"
    }
  },
  {
    "context": "Pane",
    "unbind": {
      "ctrl-pageup": "pane::ActivatePreviousItem"
    }
  },
  {
    "bindings": {
      "alt-o": "pane::CloseActiveItem"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-d": "editor::DuplicateLineDown"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-alt-shift-down": "editor::DuplicateLineDown"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-shift-up": "editor::DuplicateLineUp"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "ctrl-alt-shift-up": "editor::DuplicateLineUp"
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "alt-.": "editor::GoToHunk"
    }
  },
  {
    "bindings": {
      "alt-.": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-`": "terminal_panel::Toggle"
    }
  },
  {
    "context": "Terminal",
    "unbind": {
      "alt-.": [
        "terminal::SendText",
        "\u001b."
      ]
    }
  },
  {
    "bindings": {
      "ctrl-shift-q": "zed::Quit"
    }
  },
  {
    "unbind": {
      "ctrl-q": "zed::Quit"
    }
  }
]
